[
  { "name": "unsorted", "input": { "values": [12, 11, 13, 5, 6] }, "expected": [5, 6, 11, 12, 13] },
  { "name": "already sorted", "input": { "values": [1, 2, 3, 4] }, "expected": [1, 2, 3, 4] },
  { "name": "reversed", "input": { "values": [4, 3, 2, 1] }, "expected": [1, 2, 3, 4] },
  { "name": "duplicates", "input": { "values": [3, 1, 3, 1, 2] }, "expected": [1, 1, 2, 3, 3] },
  { "name": "empty array", "input": { "values": [] }, "expected": [] },
  { "name": "single value", "input": { "values": [8] }, "expected": [8] },
  { "name": "two values swapped", "input": { "values": [2, 1] }, "expected": [1, 2] },
  { "name": "negatives and zero", "input": { "values": [0, -3, 7, -3, 2] }, "expected": [-3, -3, 0, 2, 7] },
  { "name": "limit values", "input": { "values": [999, -999, 0] }, "expected": [-999, 0, 999] }

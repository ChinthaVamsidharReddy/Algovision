{
  "name": "@algovision/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pyodide.mjs && next dev",
    "build": "node ../../tools/content-compiler/compile.mjs && node scripts/copy-pyodide.mjs && next build",
    "start": "next start",
    "typecheck": "node ../../tools/content-compiler/compile.mjs && tsc -p tsconfig.json",
    "test": "node ../../tools/content-compiler/compile.mjs && vitest run"
  },
  "dependencies": {
    "@algovision/algorithms": "workspace:*",
    "@algovision/trace-schema": "workspace:*",
    "@algovision/viz-engine": "workspace:*",
    "next": "^16.4.3",
    "pyodide": "0.27.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.0",
    "axe-core": "^4.10.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}

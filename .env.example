# Copy to .env (never commit it). Values below are for local development only.

# --- Database (docker compose postgres) ---
DB_USERNAME=algovision
DB_PASSWORD=algovision
DB_URL=jdbc:postgresql://localhost:5432/algovision

# --- API ---
# Exact origins of the web app, comma-separated. No paths, no wildcards.
ALLOWED_ORIGINS=http://localhost:3000
# Never disable in production.
ORIGIN_CHECK_ENABLED=true

# Required. At least 32 random bytes, e.g. `openssl rand -base64 48`. Never reuse across environments.
AUTH_TOKEN_SECRET=change-me-dev-only-0123456789abcdef0123456789abcdef
# Secure cookies need https; false only for plain-http local development.
AUTH_COOKIE_SECURE=false

# --- Web ---
# Where the Next.js server proxies /api/* (server-side only).
API_INTERNAL_URL=http://localhost:8080
# Visualization limits profile: standard | lite (can also be forced per visit with ?limits=lite).
NEXT_PUBLIC_VIZ_LIMIT_PROFILE=standard
